<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/bg_widget_card">

    <!-- الشريط العلوي: اسم التطبيق + أيام المداومة -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FAF6F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="توازن اليوم"
            android:textColor="#F0BC68"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- الكفّتان: ذِكر اليوم + صرف اليوم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_zekr_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:padding="9dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_inner">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذِكر اليوم"
                android:textColor="#9DBBA9"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_zekr_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FAF6F0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_expense_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:padding="9dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_inner">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صرف اليوم"
                android:textColor="#ADD0E8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expense_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ج.م"
                android:textColor="#FAF6F0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- أزرار سريعة مباشرة: + سبّح و + مصروف -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/widget_btn_tasbih"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_zekr"
            android:text="+ سبّح"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_expense"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_budget"
            android:text="+ مصروف"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
